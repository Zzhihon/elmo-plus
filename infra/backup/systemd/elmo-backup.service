[Unit]
Description=Elmo GEO daily backup (PostgreSQL + object store, encrypted, off site)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=elmo-backup
Environment=BACKUP_ENV_FILE=/opt/elmo/infra/compose/.env
ExecStart=/opt/elmo/infra/backup/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
