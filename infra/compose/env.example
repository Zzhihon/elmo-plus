# Copy to infra/compose/.env (gitignored) and replace every value. All values
# here are placeholders; none of them work as-is.
#
# Generate secrets with:  openssl rand -base64 32   (ELMO_ENCRYPTION_KEY must decode to 32 bytes)
#                         openssl rand -hex 24      (passwords and object store keys)

# ── Images ───────────────────────────────────────────────────────────────────
ELMO_IMAGE_REPO=registry.example-electric.test/elmo
ELMO_IMAGE_TAG=2026.11.0
ELMO_WEB_PORT=3000

# ── Application ──────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=local
APP_URL=https://geo.example-electric.test
VITE_APP_URL=https://geo.example-electric.test
APP_NAME=示例电气 GEO 工作台
VITE_APP_NAME=示例电气 GEO 工作台
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
ELMO_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLTMyLXJhbmRvbS1ieXRlcy0hISE=
# ELMO_ENCRYPTION_KEY_OLD=   # previous key(s) during a rotation, comma-separated
DISABLE_TELEMETRY=1

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://elmo:replace-with-a-long-random-password@postgres:5432/elmo

# ── Providers ────────────────────────────────────────────────────────────────
# Sampling targets and one direct LLM key, as described in the configuration
# guide. LLM calls from the GEO workspace stay off until two platform admins
# approve them in 工作台设置 → 审批.
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub
TYPESAFE_API_KEY=stub
# OPENROUTER_API_KEY=

# ── GEO workspace ────────────────────────────────────────────────────────────
GEO_WORKSPACE_ENABLED=1
GEO_BUCKET=elmo-geo
GEO_OBJECT_STORE_URL=http://geo-objectstore:8333/elmo-geo
GEO_OBJECT_STORE_ACCESS_KEY=replace-with-openssl-rand-hex-24
GEO_OBJECT_STORE_SECRET_KEY=replace-with-openssl-rand-hex-24
GEO_OBJECT_STORE_REGION=us-east-1
GEO_PDF_FONT_PATH=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
# Set both only when running with `--profile clamav`; uploads are marked
# 未扫描 when they are unset.
GEO_CLAMD_HOST=clamav
GEO_CLAMD_PORT=3310
# Deployment-specific bootstrap JSON, mounted into the containers and kept out of git.
# GEO_BOOTSTRAP_PATH=/run/elmo/geo-bootstrap.json

# ── Backups (read by infra/backup/*.sh on the host, not by the containers) ──
BACKUP_DIR=/var/backups/elmo
# Host-side addresses: the compose names above do not resolve outside Docker.
# Keep the password out of this URL and in ~/.pgpass so it never shows in `ps`.
BACKUP_DATABASE_URL=postgres://elmo@127.0.0.1:5432/elmo
BACKUP_OBJECT_STORE_ENDPOINT=http://127.0.0.1:8333
# age public key; the matching private identity is stored off this host.
BACKUP_AGE_RECIPIENT=age1examplerecipientreplacewithyourownpublickeyxxxxxxxxxxxxxxxxxx
# rclone remote configured by the operator, e.g. a bucket in another region with versioning.
BACKUP_OFFSITE_REMOTE=offsite:example-electric-elmo-backups
BACKUP_KEEP_LOCAL=7
